FUNCTION MakeView_V_NOTAPED
***************** View setup for V_NOTAPED ***************

CREATE SQL VIEW "V_NOTAPED" ; 
   AS select  notaped_cab.tipo,notaped_cab.letra, notaped_cab.sucursal, notaped_cab.numero, notaped_cab.fecha, SUM(notaped_det.saldo) AS SUM_SALDO, notaped_cab.cliente, Clientes.razon_social, notaped_cab.prefijo, notaped_cab.valides, notaped_cab.neto FROM  datos!notaped_cab inner join  datos!notaped_det  on Str(notaped_cab.sucursal,2)+Str(notaped_cab.numero,8) = Str(notaped_det.sucursal,2)+Str(notaped_det.numero,8)  inner join  datos!Clientes on   notaped_cab.cliente = Clientes.codigo  HAVING SUM_SALDO # 0  and notaped_cab.cliente = ?l_cliente GROUP BY notaped_cab.sucursal,notaped_cab.NUMERO ORDER BY Clientes.razon_social

