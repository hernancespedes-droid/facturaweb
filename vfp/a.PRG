SELECT 0
USE parametros
_path = ALLTRIM(parametros.path_proveedores)+'p_proveedores'
USE

SELECT 0
USE (_path) ORDER principal ALIAS prove

SELECT 0
SELECT pro_razon_social AS razsocial, pro_icodigo AS codproveed,;
       ALLTRIM(pro_ccalle) + ALLTRIM(STR(pro_inumero) + " " + ALLTRIM(pro_npiso);
        + " " + ALLTRIM(pro_cdepartamento)) AS calle, pro_clocalidad AS loc,;
       pro_ctelefono AS tel, pro_ctelefono_vendedor AS telven;
     FROM (_path);
     ORDER BY pro_razon_social;
     INTO CURSOR v_proveedores
