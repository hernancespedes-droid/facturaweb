# public_html de DonWeb (Ferozo): el facturador está en la subcarpeta facturador_web/ (clonada con GIT de Ferozo).
# Si el dominio del cliente apunta a otra carpeta, cambiar "facturador_web" por esa.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/facturador_web/
    RewriteRule ^(.*)$ facturador_web/public/$1 [L]
</IfModule>
