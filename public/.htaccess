Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Archivos y carpetas que existen (css, js, imágenes): se sirven tal cual.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    # Todo lo demás lo resuelve la aplicación.
    RewriteRule ^ index.php [L]
</IfModule>
